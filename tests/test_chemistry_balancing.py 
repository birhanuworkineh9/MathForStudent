from backend.services.chemistry.chemistry_engine import (
    balance_equation,
    solve_chemistry
)


def test_balance_water():
    assert balance_equation(
        "H2 + O2 -> H2O"
    ) == "2H2 + 1O2 -> 2H2O"


def test_balance_iron_oxide():
    assert balance_equation(
        "Fe + O2 -> Fe2O3"
    ) == "4Fe + 3O2 -> 2Fe2O3"


def test_balance_ammonia():
    assert balance_equation(
        "N2 + H2 -> NH3"
    ) == "1N2 + 3H2 -> 2NH3"


def test_chemistry_solver():
    result = solve_chemistry("H2 + O2 -> H2O")
    assert result["status"] == "success"